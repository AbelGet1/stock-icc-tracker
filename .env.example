# =============================================================================
# Stock ICC Tracker - Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# NEVER commit .env to version control

# =============================================================================
# SECURITY SETTINGS (REQUIRED FOR PRODUCTION)
# =============================================================================

# API Key - Set this to require authentication for all endpoints
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Allowed CORS origins (comma-separated)
# Example: https://yourapp.com,https://www.yourapp.com
# Leave empty for development (defaults to localhost only)
ALLOWED_ORIGINS=

# Disable API documentation in production (set to false)
ENABLE_DOCS=false

# =============================================================================
# COST PROTECTION (Target: <$2/month)
# =============================================================================

# Rate limiting - requests per IP per window
RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds (3600 = 1 hour)
RATE_LIMIT_WINDOW=3600

# Maximum symbols per request (prevents expensive batch operations)
MAX_SYMBOLS_PER_REQUEST=5

# Maximum requests per day across all users (hard cost protection)
MAX_REQUESTS_PER_DAY=500

# =============================================================================
# AWS CONFIGURATION
# =============================================================================

AWS_REGION=us-east-1

# Lambda function name (created by Terraform)
LAMBDA_FUNCTION_NAME=stock-icc-tracker-analyzer

# DynamoDB table names (created by Terraform)
PATTERNS_TABLE_NAME=stock-icc-tracker-patterns
SUBSCRIPTIONS_TABLE_NAME=stock-icc-tracker-subscriptions

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Path to trained model (default: models/current_model.joblib)
MODEL_PATH=

# Path to model metadata (default: models/current_metadata.json)
METADATA_PATH=

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
#
# 1. NEVER commit this file with real values to git
# 2. Use AWS Secrets Manager or Parameter Store for production secrets
# 3. Rotate API_KEY periodically (at least every 90 days)
# 4. Set ALLOWED_ORIGINS to your specific domains only
# 5. Set ENABLE_DOCS=false in production
# 6. Monitor CloudWatch for unusual request patterns
# 7. Set up billing alerts in AWS ($1 and $2 thresholds recommended)
#
# =============================================================================
